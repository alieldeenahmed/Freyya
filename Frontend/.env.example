# Copy to .env.local to change any of these. None are required for local development.

# Where the API runs. Read when the app builds and starts.
API_URL=http://localhost:4000

# The public address of the storefront, for the sitemap and share links.
# NEXT_PUBLIC_SITE_URL=https://freyya.example

# Shows this address as a mail link on the contact page.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@freyya.example

# The public demo only.
# NEXT_PUBLIC_DEMO_MODE=true
# Shared with the API. 16+ characters.
# PROXY_SECRET=
# Previews only: reaches a protected preview of the API.
# API_BYPASS_TOKEN=
