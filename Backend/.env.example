# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres connection string (Neon: Connect > pooled connection, the host with "-pooler").
# That is what the running API should use.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Migrations and the seed need a real session, so on a pooled setup give them the direct
# connection (the host without "-pooler"). Leave unset locally.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=verify-full

# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Admin sign-in. Create the hash with: npm run admin:hash -- "your password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Optional tuning
# ADMIN_SESSION_HOURS=12
# RESERVATION_MINUTES=15
# LOW_STOCK_THRESHOLD=5
# DB_POOL_MAX=5

# Deployed behind a host that proxies requests (Vercel and the like):
# TRUST_PROXY=true
# Shared with the storefront so it can pass on each visitor's address. 16+ characters.
# PROXY_SECRET=
# Lets a scheduler call /internal/sweep-reservations. 16+ characters. Without it those routes are off.
# CRON_SECRET=

# The public demo only. Never on a database you care about.
# DEMO_MODE=true
# DEMO_MAX_PENDING_ORDERS=8
# DEMO_ORDERS_PER_IP_PER_HOUR=6
